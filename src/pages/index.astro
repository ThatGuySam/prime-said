---
import "../styles/global.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content="Prime Said is a local-first search and citation layer for timestamped creator quotes."
    />
    <title>Prime Said</title>
  </head>
  <body>
    <main>
      <p class="eyebrow">Phase 0 scaffold</p>
      <h1>Find what Prime said.</h1>
      <p class="lede">
        Prime Said will search timestamped transcript excerpts locally and link each result to the
        original recording.
      </p>
      <p class="status">Search is not available in this repository phase yet.</p>
      <a class="review-link" href="/review/">Open the unreviewed caption locator →</a>
    </main>
  </body>
</html>
