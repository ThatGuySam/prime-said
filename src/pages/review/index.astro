---
import "../../styles/review.css";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="robots" content="noindex, nofollow" />
    <meta
      name="description"
      content="A source-review preview for searching real, unreviewed YouTube auto-caption tracks."
    />
    <title>Caption review · Prime Said</title>
  </head>
  <body>
    <main>
      <header class="masthead">
        <a class="wordmark" href="/" aria-label="Prime Said home"><span>PRIME</span><span>SAID</span></a>
        <p>Caption review</p>
      </header>

      <section class="search-stage" aria-labelledby="page-title">
        <div class="search-intro">
          <p class="eyebrow">Search real caption tracks</p>
          <h1 id="page-title">Find the moment.</h1>
          <p>
            Search words from the captions, then play the source at the matching time.
          </p>
        </div>

        <form id="search-form" role="search">
          <label for="transcript-search">Caption words</label>
          <div class="search-control">
            <input
              id="transcript-search"
              name="q"
              type="search"
              value="tests drive development"
              autocomplete="off"
              spellcheck="false"
            />
            <button id="clear-search" class="clear-search" type="button" aria-label="Clear search">×</button>
            <button class="search-submit" type="submit">Search</button>
          </div>
          <div class="examples" aria-label="Example searches">
            <span>Try</span>
            <button type="button" data-query="driving implementation">driving implementation</button>
            <button type="button" data-query="reverse funnel">reverse funnel</button>
            <button type="button" data-query="100% code coverage means nothing">100% code coverage</button>
          </div>
        </form>

        <p class="origin-note">
          <strong>A match is not an authorship claim.</strong> Prime may be reading Twitch chat or
          another source. Listen and inspect the screen before quoting him.
        </p>
      </section>

      <section class="results-section" aria-labelledby="results-title">
        <header class="results-header">
          <div>
            <p class="eyebrow">Caption matches</p>
            <h2 id="results-title">“tests drive development”</h2>
          </div>
          <p id="result-status" role="status" aria-live="polite">Loading…</p>
        </header>
        <div id="source-filters" class="source-filters" role="group" aria-label="Filter by source"></div>
        <ol id="results" class="results" aria-busy="true"></ol>
      </section>

      <details class="data-details">
        <summary>About these results</summary>
        <div>
          <p id="data-count">Loading real caption tracks…</p>
          <p>
            YouTube English auto captions are normalized for literal browser-side search and are
            unreviewed for wording, vocal speaker, and word origin.
          </p>
          <p>This is bounded review tooling, not a verified quote library.</p>
        </div>
      </details>
    </main>

    <aside id="player-dock" class="player-dock" aria-labelledby="player-title" hidden>
      <header>
        <div>
          <p>Playing source</p>
          <h2 id="player-title">Recording</h2>
        </div>
        <button id="close-player" type="button" aria-label="Close video player">×</button>
      </header>
      <div id="player-frame" class="player-frame"></div>
      <a id="player-source" href="https://www.youtube.com" target="_blank" rel="noreferrer">Open on YouTube</a>
    </aside>

    <script>
      import "../../scripts/review-search-interface.ts";
    </script>
  </body>
</html>
