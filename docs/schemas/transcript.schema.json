{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prime-said.example/schemas/transcript.schema.json",
  "title": "Prime Said transcript",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "transcriptId", "sourceId", "language", "pipeline", "segments"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "transcriptId": { "type": "string", "minLength": 8 },
    "sourceId": { "type": "string" },
    "language": { "type": "string", "minLength": 2 },
    "pipeline": {
      "type": "object",
      "required": ["modelId", "modelRevision", "generatedAt"],
      "properties": {
        "modelId": { "type": "string" },
        "modelRevision": { "type": "string" },
        "runtime": { "type": "string" },
        "generatedAt": { "type": "string", "format": "date-time" }
      },
      "additionalProperties": false
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["segmentId", "startMs", "endMs", "verbatim", "display", "search"],
        "properties": {
          "segmentId": { "type": "string" },
          "startMs": { "type": "integer", "minimum": 0 },
          "endMs": { "type": "integer", "minimum": 1 },
          "verbatim": { "type": "string" },
          "display": { "type": "string" },
          "search": { "type": "string" },
          "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
          "words": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "startMs", "endMs"],
              "properties": {
                "text": { "type": "string" },
                "startMs": { "type": "integer", "minimum": 0 },
                "endMs": { "type": "integer", "minimum": 1 },
                "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  }
}
