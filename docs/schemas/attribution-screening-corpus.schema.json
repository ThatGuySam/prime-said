{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prime-said.example/schemas/attribution-screening-corpus.schema.json",
  "title": "Prime Said attribution screening corpus",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "status", "purpose", "sources", "cases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "screening-unverified" },
    "purpose": { "type": "string", "minLength": 1 },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["sourceId", "captionTrack", "captionSha256", "screeningMethod"],
        "properties": {
          "sourceId": { "type": "string", "pattern": "^youtube:.+$" },
          "captionTrack": { "const": "en-orig auto-generated JSON3" },
          "captionSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "screeningMethod": { "const": "full-caption Sol Ultra pass" }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["caseId", "split", "sourceId", "startMs", "endMs", "input", "screening"],
        "properties": {
          "caseId": { "type": "string", "pattern": "^attr_dev_[a-z0-9_]+$" },
          "split": { "const": "development" },
          "sourceId": { "type": "string", "pattern": "^youtube:.+$" },
          "startMs": { "type": "integer", "minimum": 0 },
          "endMs": { "type": "integer", "minimum": 1 },
          "input": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text"],
            "properties": {
              "previousText": { "type": "string" },
              "text": { "type": "string", "minLength": 1 },
              "nextText": { "type": "string" }
            }
          },
          "screening": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "wordsFrom", "confidence", "reviewStatus", "evidenceBasis", "notes"],
            "properties": {
              "label": { "enum": ["creator-original", "quoted-source", "response", "mixed", "unknown"] },
              "wordsFrom": { "enum": ["speaker-original", "twitch-chat", "screen-source", "mixed", "unknown"] },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
              "reviewStatus": { "enum": ["screening-unverified", "user-reviewed-window"] },
              "evidenceBasis": { "enum": ["auto-captions-and-discourse", "auto-captions-and-linked-source", "user-playback-window-plus-auto-captions"] },
              "notes": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
