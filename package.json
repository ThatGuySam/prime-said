{
  "name": "prime-said",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.2.15",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && bun scripts/report-assets.ts",
    "preview": "astro preview",
    "check": "bun run check:repo && bun run check:corpus && astro check",
    "check:repo": "bun scripts/check-repo.mjs",
    "check:corpus": "bun scripts/validate-corpus.ts",
    "test": "bun test",
    "assets:report": "bun scripts/report-assets.ts",
    "eval:attribution": "bun scripts/evaluate-attribution.ts",
    "eval:review-retrieval": "bun scripts/evaluate-review-retrieval.ts",
    "fixture:review-captions": "bun scripts/build-review-caption-fixture.ts",
    "export:review-search": "bun scripts/export-review-search-corpus.ts",
    "ingest:backfill": "bun scripts/ingest-backfill.ts",
    "benchmark:generate": "bun scripts/generate-synthetic-vectors.ts",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "deploy:preview": "wrangler versions upload"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@astrojs/react": "6.0.4",
    "@tailwindcss/vite": "4.3.3",
    "@types/bun": "1.2.15",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "astro": "7.2.9",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "wrangler": "4.127.1"
  },
  "dependencies": {
    "@radix-ui/react-separator": "1.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.37.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0"
  }
}
